        "YOU" => "0|S~E~1532~20260715;S~E~6442~20260714;S~E~5382~20260713;S~E~1822~20260625;S~E~11307~20260623"
        "YUM" => "0|S~E~962~20260701"
        "ZD" => "0|S~F~843~20260610"
        "ZM" => "0|S~E~5289~20260713;S~F~770~20260710"
        "ZS" => "1|S~F~372~20260625;S~EB~363~20260616;S~P~528~20260616;S~F~213~20260616;S~EB~303~20260317"
        => ""

if barstate.islast
    raw = data()
    if raw != ""
        ndx = str.substring(raw, 0, 1) == "1"
        if not ndxOnly or ndx
            cutT = timenow - lookback * 86400000
            cut = year(cutT) * 10000 + month(cutT) * 100 + dayofmonth(cutT)
            // one clean label per (day, direction), placed AT the bar of the trade date
            var label[] lbs = array.new_label()
            while array.size(lbs) > 0
                label.delete(array.pop(lbs))
            dts = array.new_int()
            dirs = array.new_string()
            sums = array.new_float()
            rows = str.split(str.substring(raw, 2), ";")
            for row in rows
                p = str.split(row, "~")
                if array.size(p) == 4
                    dir = array.get(p, 0)
                    tt  = array.get(p, 1)
                    kv  = str.tonumber(array.get(p, 2))
                    dt  = int(str.tonumber(array.get(p, 3)))
                    okDir  = dir == "S" ? showSell : showBuy
                    okBand = (b1 and kv >= 100 and kv < 250) or (b2 and kv >= 250 and kv < 500) or (b3 and kv >= 500)
                    okTit  = (tCEO and str.contains(tt, "E")) or (tCFO and str.contains(tt, "F")) or (tCOB and str.contains(tt, "B")) or (tPRES and str.contains(tt, "P")) or (tCOO and str.contains(tt, "O")) or (tDIR and str.contains(tt, "D"))
                    if okDir and okBand and okTit and dt >= cut
                        merged = false
                        if array.size(dts) > 0
                            for i = 0 to array.size(dts) - 1
                                if array.get(dts, i) == dt and array.get(dirs, i) == dir
                                    array.set(sums, i, array.get(sums, i) + kv)
                                    merged := true
                                    break
                        if not merged
                            array.push(dts, dt)
                            array.push(dirs, dir)
                            array.push(sums, kv)
            if array.size(dts) > 0
                for i = 0 to array.size(dts) - 1
                    dt = array.get(dts, i)
                    dir = array.get(dirs, i)
                    kv = array.get(sums, i)
                    t = timestamp(int(dt / 10000), int(dt / 100) % 100, dt % 100, 12, 0)
                    txt = (dir == "S" ? "▼ " : "▲ ") + fmtv(kv)
                    array.push(lbs, label.new(t, na, txt, xloc = xloc.bar_time, yloc = dir == "S" ? yloc.abovebar : yloc.belowbar, style = dir == "S" ? label.style_label_down : label.style_label_up, color = color.new(#b0b0b0, 20), textcolor = color.white, size = size.tiny))
