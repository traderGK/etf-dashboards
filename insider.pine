        "WAY" => "0|S~E~1613~20260715"
        "WBD" => "1|S~EP~59469~20260713"
        "WBX" => "0|B~E~886~20260630"
        "WDAY" => "1|S~P~391~20260707;S~F~862~20260707;S~P~724~20260705"
        "WLFC" => "0|S~E~1161~20260701"
        "WRBY" => "0|S~E~1621~20260706;S~E~6445~20260701;S~E~7191~20260701;S~E~1090~20260629"
