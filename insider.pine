        => ""

fname(string tt) =>
    string r = ""
    if str.contains(tt, "E")
        r += "CEO"
    if str.contains(tt, "F")
        r += (r == "" ? "" : "+") + "CFO"
    if str.contains(tt, "B")
        r += (r == "" ? "" : "+") + "COB"
    if str.contains(tt, "P")
        r += (r == "" ? "" : "+") + "Pres"
    if str.contains(tt, "O")
        r += (r == "" ? "" : "+") + "COO"
    if str.contains(tt, "D")
        r += (r == "" ? "" : "+") + "Dir"
    if r == "" and str.contains(tt, "T")
        r := "10%"
    r == "" ? "Insider" : r

// parse once, filtered by the settings; merge same-day same-direction filings
var int[]    tms  = array.new_int()
var string[] dirsA = array.new_string()
var string[] ttlsA = array.new_string()
var float[]  kvsA  = array.new_float()
if barstate.isfirst
    raw = data()
    if raw != ""
        ndxOk = str.substring(raw, 0, 1) == "1"
        if not ndxOnly or ndxOk
            cutT = timenow - lookback * 86400000
            cut = year(cutT) * 10000 + month(cutT) * 100 + dayofmonth(cutT)
            rows = str.split(str.substring(raw, 2), ";")
            for row in rows
                p = str.split(row, "~")
                if array.size(p) == 4
                    dir = array.get(p, 0)
                    tt  = array.get(p, 1)
                    kv  = str.tonumber(array.get(p, 2))
                    dt  = int(str.tonumber(array.get(p, 3)))
                    okDir  = dir == "S" ? showSell : showBuy
                    okBand = (b1 and kv >= 100 and kv < 250) or (b2 and kv >= 250 and kv < 500) or (b3 and kv >= 500)
                    okTit  = (tCEO and str.contains(tt, "E")) or (tCFO and str.contains(tt, "F")) or (tCOB and str.contains(tt, "B")) or (tPRES and str.contains(tt, "P")) or (tCOO and str.contains(tt, "O")) or (tDIR and str.contains(tt, "D")) or (tOTH and (str.contains(tt, "T") or str.contains(tt, "X")))
                    if okDir and okBand and okTit and dt >= cut
                        t = timestamp(int(dt / 10000), int(dt / 100) % 100, dt % 100, 12, 0)
                        nm = fname(tt)
                        merged = false
                        if array.size(tms) > 0
                            for i = 0 to array.size(tms) - 1
                                if array.get(tms, i) == t and array.get(dirsA, i) == dir
                                    array.set(kvsA, i, array.get(kvsA, i) + kv)
                                    cur = array.get(ttlsA, i)
                                    if not str.contains(cur, nm)
                                        array.set(ttlsA, i, cur + "+" + nm)
                                    merged := true
                                    break
                        if not merged
                            array.push(tms, t)
                            array.push(dirsA, dir)
                            array.push(ttlsA, nm)
                            array.push(kvsA, kv)

// draw on the bar whose session contains the trade date — works on any timeframe
if array.size(tms) > 0 and not na(time_close)
    for i = 0 to array.size(tms) - 1
        t = array.get(tms, i)
        if t >= time and t < time_close
            dir = array.get(dirsA, i)
            txt = (dir == "S" ? "▼ " : "▲ ") + array.get(ttlsA, i) + " " + fmtv(array.get(kvsA, i))
            bg = color.new(#b0b0b0, transp)
            if dir == "S"
                label.new(bar_index, high * (1 + offPct / 100), txt, style = label.style_label_down, color = bg, textcolor = color.white, size = size.tiny)
            else
                label.new(bar_index, low * (1 - offPct / 100), txt, style = label.style_label_up, color = bg, textcolor = color.white, size = size.tiny)
