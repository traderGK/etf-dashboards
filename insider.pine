        "VICR" => "0|S~EB~6377~20260702;S~EB~7133~20260701;S~EB~7500~20260630;S~EB~3214~20260629;S~EB~3878~20260629;S~EB~6461~20260626;S~EB~6611~20260625"
        "VII" => "0|B~E~3000~20260706"
        "VRSK" => "1|S~D~851~20260605;S~D~1201~20260602;S~D~408~20260601;S~D~400~20260522"
        "VRSN" => "0|S~EBP~883~20260714;S~EBP~878~20260707;S~EBP~828~20260630"
        "VRTX" => "1|S~D~134~20260504"
